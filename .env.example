# Get these from the Fanvue Developer Area when you create an app https://fanvue.com/developers
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Local Phase 0 (must match the Fanvue app Redirect URI exactly)
OAUTH_REDIRECT_URI="http://localhost:3000/api/oauth/callback"
BASE_URL="http://localhost:3000"

# Must match the scopes enabled on the Fanvue app. Phase 0/1 needs all of these.
OAUTH_SCOPES="read:self read:chat write:chat read:post write:post read:media write:media read:creator write:creator"

OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
SESSION_COOKIE_NAME=fvsession
SESSION_SECRET=youshouldreallychangethis
API_BASE_URL=https://api.fanvue.com

# Optional: Python agent login on Windows (register this URI too)
# FANVUE_AGENT_REDIRECT_URI=http://localhost:8765/callback

# Telegram status bot (@drkgma78bot). Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
