# Get these from the Fanvue Developer Area when you create an app
# https://fanvue.com/developers
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must match a Redirect URI registered on the Fanvue app.
# Local Cloud Agent / Next.js default:
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Add scopes here once you have configured them in your app, space separated, e.g. "read:self read:chat"
OAUTH_SCOPES=read:self
OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
# Set this to whatever you want your session cookie to be called
SESSION_COOKIE_NAME=fvsession
# Set this to a random string of at least 16 characters. Do not commit the real value.
SESSION_SECRET=
# Don't change this; your app won't be able to talk to Fanvue's API if you do
API_BASE_URL=https://api.fanvue.com
BASE_URL=http://localhost:3000
